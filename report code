#!/bin/bash

# ==========================================
# KMS Log Analyzer
# ==========================================

LOG_FILE="/root/main.log"

# Check required tools
if ! command -v awk >/dev/null 2>&1; then
    echo "Error: awk is not installed."
    exit 1
fi

# Check log file
if [[ ! -r "$LOG_FILE" ]]; then
    echo "Error: Cannot read $LOG_FILE"
    exit 1
fi

# Convert line endings if needed
if command -v dos2unix >/dev/null 2>&1; then
    dos2unix "$LOG_FILE" 2>/dev/null
fi

echo
echo "======================================"
echo "          KMS LOG ANALYZER"
echo "======================================"
echo

read -r -p "Search for a specific IP? (Enter IP or leave blank for full report): " search_ip

# Validate IP input when provided
if [[ -n "$search_ip" ]]; then
    if [[ ! "$search_ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
        echo "Error: Invalid IPv4 address format."
        exit 1
    fi

    # Count requests for the selected IP
    count=$(awk -v sip="$search_ip" '
        $5 ~ /accepted:/ &&
        $1 ~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/ {
            split($6, a, ":")
            ip = a[1]

            if (ip == sip)
                c++
        }
        END {
            print c+0
        }
    ' "$LOG_FILE")

    echo
    echo "--------------------------------------"

    if (( count > 0 )); then
        echo "IP: $search_ip"
        echo "Accepted requests: $count"
    else
        echo "IP $search_ip not found in accepted requests."
    fi

    echo "--------------------------------------"
    echo

    read -r -p "Press Enter to continue to the full report..." dummy
fi

# Generate full report
awk '
$5 ~ /accepted:/ &&
$1 ~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/ {

    split($6, a, ":")
    ip = a[1]

    # Count accepted requests per IP
    count[ip]++

    # Build timestamp
    ts = $1 " " $2

    # First and last occurrence
    if (!(ip in first_seen))
        first_seen[ip] = ts

    last_seen[ip] = ts
}

function sum(array, s, i) {
    s = 0
    for (i in array)
        s += array[i]
    return s
}

END {
    total_requests = sum(count)
    total_ips = 0

    for (ip in count)
        total_ips++

    printf "\n"
    printf "============================================================\n"
    printf "                    SUMMARY OF KMS LOGS\n"
    printf "============================================================\n"
    printf "TOTAL REQUESTS: %d\n", total_requests
    printf "TOTAL UNIQUE IPs: %d\n", total_ips
    printf "============================================================\n\n"

    printf "%-18s %-10s %-20s %-20s\n", \
           "IP", "COUNT", "FIRST_SEEN", "LAST_SEEN"

    printf "%s\n", \
           "--------------------------------------------------------------------------"

    # Print report sorted by request count (descending)
    for (ip in count) {
        printf "%-18s %-10d %-20s %-20s\n", \
               ip, count[ip], first_seen[ip], last_seen[ip]
    }

    printf "\n============================================================\n"
    printf "Report completed.\n"
}
' "$LOG_FILE" | sort -k2,2nr | less
